generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("field_operator") // super_admin, zone_manager, field_operator, auditor
  status    String   @default("active") // active, disabled
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  zoneAssignments      ZoneAssignment[]
  manualReadings       Reading[]              @relation("EnteredBy")
  alertsAcknowledged   Alert[]                @relation("AcknowledgedBy")
  alertsResolved       Alert[]                @relation("ResolvedBy")
  thresholdsCreated    AlertThreshold[]       @relation("CreatedBy")
  controlRequests      DeviceControlRequest[] @relation("RequestedBy")
  controlReviews       DeviceControlRequest[] @relation("ReviewedBy")
  reportsGenerated     Report[]
  auditLogs            AuditLog[]
  refreshTokens        RefreshToken[]
  passwordResets       PasswordReset[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model Zone {
  id          String   @id @default(uuid())
  name        String
  description String?
  city        String   @default("District 1")
  createdAt   DateTime @default(now()) @map("created_at")

  buildings       Building[]
  alerts          Alert[]
  alertThresholds AlertThreshold[]
  zoneAssignments ZoneAssignment[]
  reports         Report[]

  @@map("zones")
}

model ZoneAssignment {
  id     String @id @default(uuid())
  userId String @map("user_id")
  zoneId String @map("zone_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([userId, zoneId])
  @@map("zone_assignments")
}

model Building {
  id        String   @id @default(uuid())
  zoneId    String   @map("zone_id")
  name      String
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  zone            Zone             @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  devices         Device[]
  alerts          Alert[]          @relation("BuildingAlerts")
  alertThresholds AlertThreshold[] @relation("BuildingThresholds")

  @@map("buildings")
}

model Device {
  id          String    @id @default(uuid())
  buildingId  String    @map("building_id")
  name        String
  type        String    // light, hvac, street_lamp, solar_inverter, wind_inverter, smart_meter, other
  impactLevel String    @default("low") @map("impact_level") // low, high
  status      String    @default("online") // online, controlled_off, stale
  lastSeenAt  DateTime? @map("last_seen_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  building        Building               @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  readings        Reading[]
  alerts          Alert[]                @relation("DeviceAlerts")
  alertThresholds AlertThreshold[]       @relation("DeviceThresholds")
  controlRequests DeviceControlRequest[]

  @@map("devices")
}

model Reading {
  id            String   @id @default(uuid())
  deviceId      String   @map("device_id")
  kwh           Float
  energySource  String   @map("energy_source") // grid, solar, wind, manual
  recordedAt    DateTime @map("recorded_at")
  ingestionType String   @map("ingestion_type") // iot, manual, utility_api, inverter_api
  enteredBy     String?  @map("entered_by")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user   User?  @relation("EnteredBy", fields: [enteredBy], references: [id], onDelete: SetNull)

  @@unique([deviceId, recordedAt, ingestionType])
  @@index([deviceId, recordedAt(sort: Desc)])
  @@index([recordedAt(sort: Desc)])
  @@map("readings")
}

model AlertThreshold {
  id           String   @id @default(uuid())
  zoneId       String?  @map("zone_id")
  buildingId   String?  @map("building_id")
  deviceId     String?  @map("device_id")
  thresholdKwh Float    @map("threshold_kwh")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  zone     Zone?     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  building Building? @relation("BuildingThresholds", fields: [buildingId], references: [id], onDelete: Cascade)
  device   Device?   @relation("DeviceThresholds", fields: [deviceId], references: [id], onDelete: Cascade)
  creator  User      @relation("CreatedBy", fields: [createdBy], references: [id])
  alerts   Alert[]

  @@map("alert_thresholds")
}

model Alert {
  id             String    @id @default(uuid())
  zoneId         String    @map("zone_id")
  buildingId     String?   @map("building_id")
  deviceId       String?   @map("device_id")
  thresholdId    String?   @map("threshold_id")
  severity       String    // info, warning, critical
  message        String
  status         String    @default("new") // new, acknowledged, resolved
  acknowledgedBy String?   @map("acknowledged_by")
  acknowledgedAt DateTime? @map("acknowledged_at")
  resolvedBy     String?   @map("resolved_by")
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  zone       Zone            @relation(fields: [zoneId], references: [id])
  building   Building?       @relation("BuildingAlerts", fields: [buildingId], references: [id])
  device     Device?         @relation("DeviceAlerts", fields: [deviceId], references: [id])
  threshold  AlertThreshold? @relation(fields: [thresholdId], references: [id])
  acknowledger User?         @relation("AcknowledgedBy", fields: [acknowledgedBy], references: [id])
  resolver     User?         @relation("ResolvedBy", fields: [resolvedBy], references: [id])

  @@index([zoneId, status])
  @@map("alerts")
}

model DeviceControlRequest {
  id             String    @id @default(uuid())
  deviceId       String    @map("device_id")
  requestedBy    String    @map("requested_by")
  requestedState String    @map("requested_state") // online, controlled_off
  status         String    @default("pending") // pending, approved, rejected
  reviewedBy     String?   @map("reviewed_by")
  reviewedAt     DateTime? @map("reviewed_at")
  reason         String?
  createdAt      DateTime  @default(now()) @map("created_at")

  device   Device @relation(fields: [deviceId], references: [id])
  requester User  @relation("RequestedBy", fields: [requestedBy], references: [id])
  reviewer  User? @relation("ReviewedBy", fields: [reviewedBy], references: [id])

  @@map("device_control_requests")
}

model Report {
  id          String   @id @default(uuid())
  generatedBy String   @map("generated_by")
  zoneId      String?  @map("zone_id")
  dateFrom    DateTime @map("date_from")
  dateTo      DateTime @map("date_to")
  filters     String?  // JSON string
  rowCount    Int?     @map("row_count")
  status      String   @default("pending") // pending, ready, failed
  createdAt   DateTime @default(now()) @map("created_at")

  user User  @relation(fields: [generatedBy], references: [id])
  zone Zone? @relation(fields: [zoneId], references: [id])

  @@map("reports")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   String?  // JSON string
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SystemConfig {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("system_config")
}
